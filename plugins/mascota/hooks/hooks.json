{
  "description": "Avisos de la mascota: estados por HTTP y apertura automática al iniciar sesión",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/arrancar.py",
              "--al-iniciar"
            ],
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/estado/pensando",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/estado/permiso",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/estado/permiso",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/estado/listo",
            "timeout": 3
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/estado/cansado",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "overloaded|authentication_failed|oauth_org_not_allowed|account_on_hold|billing_error|invalid_request|model_not_found|server_error|max_output_tokens|cloud_credential_error|unknown",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/estado/error",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:8765/estado/esperando",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
